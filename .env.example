# Optional: defaults work without copying this file.
# SQLite paths are relative to apps/api/prisma/schema.prisma.
DATABASE_URL=file:./dev.db
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# Server-side URL used by the Next.js dashboard.
API_URL=http://127.0.0.1:4000/graphql
MONITOR_TARGETS_FILE=monitors.json
MONITOR_INTERVAL_SECONDS=30
MONITOR_TIMEOUT_MS=5000

# Observability Stack URLs (Docker Defaults)
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
TEMPO_URL=http://127.0.0.1:3200
GRAFANA_URL=http://127.0.0.1:3001
OTEL_COLLECTOR_URL=http://127.0.0.1:13133
QDRANT_URL=http://127.0.0.1:6333

# Optional LLM Provider API Keys (Fallback to deterministic synthesis when empty)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

